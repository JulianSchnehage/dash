{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog-recipekit.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% comment %}
  This template has two distinct views:
  1. The "All" view: Shows the first 3 articles from each tag category
  2. Filtered tag view: Shows all articles with the selected tag (with pagination)
{% endcomment %}

{% comment %} Determine which view to show based on URL parameters {% endcomment %}
{% assign is_all_view = true %}
{% if current_tags.size > 0 %}
  {% assign is_all_view = false %}
  {% paginate blog.articles by 44 %}
{% endif %}

<div class="main-blog page-width section-{{ section.id }}-padding">
  {% comment %} Page Header/Banner Section {% endcomment %}
  {% if request.path contains '/blogs/recipes' %}
    {% comment %} Set up banner image and text {% endcomment %}
    {%- assign active_block = null -%}
    {% for block in section.blocks %}
      {% if current_tags contains block.settings.tag %}
        {% assign active_block = block %}
      {% endif %}
    {% endfor %}
    
    {% assign banner_image = section.settings.default_banner_image %}
    {% assign banner_headline = section.settings.default_banner_headline %}
    
    {% if active_block != null and active_block.settings.banner_image != blank %}
      {% assign display_image = active_block.settings.banner_image %}
    {% else %}
      {% assign display_image = banner_image %}
    {% endif %}
    
    {% if display_image == blank %}
      {% assign display_image = 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80' %}
    {% endif %}
    
    {% if active_block != null and active_block.settings.headline != blank %}
      {% assign display_headline = active_block.settings.headline %}
    {% else %}
      {% assign display_headline = banner_headline %}
    {% endif %}

    <div class="blog-banner">
      <div class="blog-banner-image">
        <img src="{{ display_image | img_url: '2000x' }}" alt="{{ display_headline }}" height="180">
        <div class="blog-banner-overlay">&nbsp;</div>
        <div class="blog-banner-text">
          <h1 class="blog-banner-headline">{{ display_headline }}</h1>
          {% if section.settings.secondary_banner_headline != blank %}
            <div class="blog-banner-subheadline">{{ section.settings.secondary_banner_headline }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <h1 class="title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ blog.title | escape }}
    </h1>
  {% endif %}

  {% comment %} Filter Navigation Section {% endcomment %}
  {% if request.path contains '/blogs/recipes' %}
    <div class="blog-filter-wrapper">
      {% comment %} Desktop/Tablet Filter List {% endcomment %}
      <div class="blog-filter blog-filter-list">
        {% assign all_active = false %}
        {% if is_all_view %}
          {% assign all_active = true %}
        {% endif %}
        
        <a
          href="/blogs/recipes"
          class="blog-filter__item{% if all_active %} blog-filter__item--active{% endif %}"
          role="tab"
          aria-selected="{{ all_active }}"
          aria-label="Show all recipes"
          tabindex="0"
        >
          All
        </a>
        
        {% for block in section.blocks %}
          {% assign tag = block.settings.tag %}
          {% if tag != blank %}
            {% assign is_active = false %}
            {% if current_tags contains tag %}
              {% assign is_active = true %}
            {% endif %}
            
            <a
              href="{% if is_active %}/blogs/recipes{% else %}/blogs/recipes/tagged/{{ tag | handle }}{% endif %}"
              class="blog-filter__item{% if is_active %} blog-filter__item--active{% endif %}"
              role="tab"
              aria-selected="{{ is_active }}"
              aria-label="Filter recipes by {{ tag }}"
              tabindex="0"
            >
              {{ tag }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      
      {% comment %} Mobile Dropdown Filter {% endcomment %}
      <div class="blog-filter-dropdown">
        <select onchange="if(this.value) window.location.href=this.value;">
          <option value="">Select Category</option>
          <option value="/blogs/recipes" {% if all_active %}selected{% endif %}>All</option>
          {% for block in section.blocks %}
            {% assign tag = block.settings.tag %}
            {% if tag != blank %}
              {% assign is_active = false %}
              {% if current_tags contains tag %}
                {% assign is_active = true %}
              {% endif %}
              <option value="{% if is_active %}/blogs/recipes{% else %}/blogs/recipes/tagged/{{ tag | handle }}{% endif %}" {% if is_active %}selected{% endif %}>{{ tag }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
    </div>

    {% comment %} Set up color mapping for category badges {% endcomment %}
    {%- assign tag_color_map = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.tag != blank and block.settings.banner_color != blank -%}
        {%- assign tag_color_map = tag_color_map | append: block.settings.tag | append: ':' | append: block.settings.banner_color | append: ',' -%}
      {%- endif -%}
    {%- endfor -%}
    
    {% comment %} MAIN CONTENT DISPLAY - Two different views: All view or Tag-filtered view {% endcomment %}
    {% if is_all_view %}
      {% comment %} ALL VIEW - Show 3 posts from each tag category {% endcomment %}
      {% for block in section.blocks %}
        {% assign tag = block.settings.tag %}
        {% if tag != blank %}
          {% comment %} Find all articles with this tag {% endcomment %}
          {% assign tagged_articles = blog.articles | where: 'tags', tag %}
          {% if tagged_articles.size > 0 %}
            <div class="tag-section">
              <h2 class="tag-section-title">{{ tag }}</h2>
              <div class="main-blog-recipekit-grid">
                {% for article in tagged_articles limit: 3 %}
                  {%- assign rk_resource_id = article.id | downcase -%}
                  {%- assign rk_mf = article.metafields.recipekit[rk_resource_id] -%}
                  <div class="recipekit-card-outer">
                    <a href="{{ article.url }}" class="recipekit-card-link" aria-label="{{ article.title | escape }}">
                      <div class="recipekit-card">
                        <div class="recipekit-card-image-wrapper">
                          {%- if rk_mf and rk_mf.recipe_image != blank -%}
                            {%- assign image_url = rk_mf.recipe_image -%}
                            {%- if image_url contains 'cloudinary.com' -%}
                              {%- assign rk_last_url = image_url | split: 'upload/' -%}
                              {%- assign card_image = rk_last_url[1] | prepend: 'https://res.cloudinary.com/hsxfx8igq/image/upload/t_1x1_recipe_image,f_auto/' -%}
                            {%- elsif image_url contains 'backblazeb2.com' -%}
                              {%- assign rk_last_url = image_url | split: 'backblazeb2.com/file/recipekit-bucket/' -%}
                              {%- assign card_image = 'https://images.getrecipekit.com/' | append: rk_last_url[1] | append: '?aspect_ratio=1:1&quality=90&' -%}
                            {%- elsif image_url contains 'cdn.shopify.com' -%}
                              {%- assign card_image = image_url | append: '&width=1000&height=1000' -%}
                            {%- else -%}
                              {%- assign card_image = image_url -%}
                            {%- endif -%}
                            <img class="recipekit-card-image" src="{{ card_image }}" alt="{{ article.title | escape }}" loading="lazy">
                          {%- elsif article.image -%}
                            <img class="recipekit-card-image" src="{{ article.image | img_url: '1000x1000', scale: 2 }}" alt="{{ article.title | escape }}" loading="lazy">
                          {%- endif -%}
                          {%- if rk_mf and rk_mf.prep_time != blank -%}
                            <span class="recipekit-prep-time">{{ rk_mf.prep_time }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    </a>
                    <div class="recipekit-card-meta">
                      {%- if rk_mf and rk_mf.recipe_category != blank -%}
                        {%- assign badge_color = '' -%}
                        {%- assign tag_pairs = tag_color_map | split: ',' -%}
                        {%- for pair in tag_pairs -%}
                          {%- assign pair_tag = pair | split: ':' | first -%}
                          {%- assign color = pair | split: ':' | last -%}
                          {%- if rk_mf.recipe_category == pair_tag -%}
                            {%- assign badge_color = color -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <span class="recipekit-category-badge"{% if badge_color != '' %} style="background: {{ badge_color }}"{% endif %}>{{ rk_mf.recipe_category }}</span>
                      {%- endif -%}
                      <a href="{{ article.url }}" class="recipekit-card-title-link"><div class="recipekit-card-title">{{ article.title }}</div></a>
                    </div>
                  </div>
                {% endfor %}
              </div>
              
              {% if tagged_articles.size > 3 %}
                <div class="view-all-link-wrapper">
                  <a href="/blogs/recipes/tagged/{{ tag | handle }}" class="view-all-link">View all {{ tag }} ({{ tagged_articles.size }})</a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% comment %} TAG-FILTERED VIEW - Show all articles with the selected tag {% endcomment %}
      <div class="main-blog-recipekit-grid">
        {%- for article in blog.articles -%}
          {%- assign rk_resource_id = article.id | downcase -%}
          {%- assign rk_mf = article.metafields.recipekit[rk_resource_id] -%}
          <div class="recipekit-card-outer">
            <a href="{{ article.url }}" class="recipekit-card-link" aria-label="{{ article.title | escape }}">
              <div class="recipekit-card">
                <div class="recipekit-card-image-wrapper">
                  {%- if rk_mf and rk_mf.recipe_image != blank -%}
                    {%- assign image_url = rk_mf.recipe_image -%}
                    {%- if image_url contains 'cloudinary.com' -%}
                      {%- assign rk_last_url = image_url | split: 'upload/' -%}
                      {%- assign card_image = rk_last_url[1] | prepend: 'https://res.cloudinary.com/hsxfx8igq/image/upload/t_1x1_recipe_image,f_auto/' -%}
                    {%- elsif image_url contains 'backblazeb2.com' -%}
                      {%- assign rk_last_url = image_url | split: 'backblazeb2.com/file/recipekit-bucket/' -%}
                      {%- assign card_image = 'https://images.getrecipekit.com/' | append: rk_last_url[1] | append: '?aspect_ratio=1:1&quality=90&' -%}
                    {%- elsif image_url contains 'cdn.shopify.com' -%}
                      {%- assign card_image = image_url | append: '&width=1000&height=1000' -%}
                    {%- else -%}
                      {%- assign card_image = image_url -%}
                    {%- endif -%}
                    <img class="recipekit-card-image" src="{{ card_image }}" alt="{{ article.title | escape }}" loading="lazy">
                  {%- elsif article.image -%}
                    <img class="recipekit-card-image" src="{{ article.image | img_url: '1000x1000', scale: 2 }}" alt="{{ article.title | escape }}" loading="lazy">
                  {%- endif -%}
                  {%- if rk_mf and rk_mf.prep_time != blank -%}
                    <span class="recipekit-prep-time">{{ rk_mf.prep_time }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            <div class="recipekit-card-meta">
              {%- if rk_mf and rk_mf.recipe_category != blank -%}
                {%- assign badge_color = '' -%}
                {%- assign tag_pairs = tag_color_map | split: ',' -%}
                {%- for pair in tag_pairs -%}
                  {%- assign pair_tag = pair | split: ':' | first -%}
                  {%- assign color = pair | split: ':' | last -%}
                  {%- if rk_mf.recipe_category == pair_tag -%}
                    {%- assign badge_color = color -%}
                  {%- endif -%}
                {%- endfor -%}
                <span class="recipekit-category-badge"{% if badge_color != '' %} style="background: {{ badge_color }}"{% endif %}>{{ rk_mf.recipe_category }}</span>
              {%- endif -%}
              <a href="{{ article.url }}" class="recipekit-card-title-link"><div class="recipekit-card-title">{{ article.title }}</div></a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      
      {% comment %} Pagination for tag-filtered view {% endcomment %}
      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {% endif %}
  {% endif %}
</div>

{% comment %} Close pagination if in tag-filtered view {% endcomment %}
{% if current_tags.size > 0 %}
  {%- endpaginate -%}
{% endif %}

<style>
.blog-banner {
  width: 100%;
  margin-bottom: 32px;
}
.blog-banner-image {
  position: relative;
  width: 100%;
  height: 180px;
  overflow: hidden;
}
.blog-banner-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  text-align: center;
  z-index: 2;
  color: #fff;
  padding: 0 32px;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.blog-banner-headline {
  text-align: center;
  font-size: 2.8em;
  font-weight: 700;
  margin-bottom: 0.2em;
  color: #fff;
  text-shadow: 0 2px 12px rgba(0,0,0,0.22);
  z-index: 2;
  position: relative;
}
.blog-banner-subheadline {
  text-align: center;
  font-size: 1.3em;
  font-weight: 400;
  color: #fff;
  margin-bottom: 1em;
  z-index: 2;
  position: relative;
  text-shadow: 0 2px 8px rgba(0,0,0,0.18);
}

@media screen and (max-width: 600px) {
  .blog-banner-headline {
    font-size: 1.4em;
    margin-bottom: 0.3em;
  }
  .blog-banner-subheadline {
    font-size: 1em;
    margin-bottom: 0.6em;
  }
}
</style>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "default_banner_image",
      "label": "Default Banner Image"
    },
    {
      "type": "text",
      "id": "default_banner_headline",
      "label": "Default Banner Headline",
      "default": "Delicious Recipes"
    },
    {
      "type": "text",
      "id": "secondary_banner_headline",
      "label": "Secondary Banner Headline",
      "default": "Discover a world of flavors"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "recipe_category",
      "name": "Recipe Category",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Dessert"
        },
        {
          "type": "color",
          "id": "banner_color",
          "label": "Banner Color",
          "default": "#8a0080"
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Banner Headline"
        }
      ]
    }
  ]
}
{% endschema %}
