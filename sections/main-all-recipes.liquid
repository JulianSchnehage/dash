{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css'        | asset_url | stylesheet_tag }}
{{ 'section-main-blog-recipekit.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px){
    .section-{{ section.id }}-padding{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">

  {% comment %}
    Build a lookup for tag → badge-color so we can tint the category chips
  {% endcomment %}
  {%- assign tag_color_map = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tag != blank and block.settings.banner_color != blank -%}
      {%- assign tag_color_map = tag_color_map
        | append: block.settings.tag | append: ':' | append: block.settings.banner_color | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign recipes = blogs['recipes'].articles -%}

  {% for block in section.blocks %}
    {%- assign tag = block.settings.tag -%}
    {%- assign headed = false -%}
    <div class="category-group-wrapper" style="margin-bottom:3rem;">
      <h2 class="category-heading" style="margin:2.5rem 0 1.2rem 0;">{{ tag }}</h2>
      <div class="main-blog-recipekit-grid">
        {%- assign tag_articles = recipes | where: "tags", tag | slice: 0, 3 -%}
        {% for article in tag_articles %}
          {%- assign rk_resource_id = article.id | downcase -%}
          {%- assign rk_mf = article.metafields.recipekit[rk_resource_id] -%}
          <div class="recipekit-card-outer">
            <a href="{{ article.url }}" class="recipekit-card-link" aria-label="{{ article.title | escape }}">
              <div class="recipekit-card">
                <div class="recipekit-card-image-wrapper">
                  {%- comment %} pick best image source {%- endcomment -%}
                  {%- if rk_mf and rk_mf.recipe_image != blank -%}
                    {%- assign image_url = rk_mf.recipe_image -%}
                    {%- if image_url contains 'cloudinary.com' -%}
                      {%- assign rk_last = image_url | split: 'upload/' -%}
                      {%- assign card_image = rk_last[1] | prepend: 'https://res.cloudinary.com/hsxfx8igq/image/upload/t_1x1_recipe_image,f_auto/' -%}
                    {%- elsif image_url contains 'backblazeb2.com' -%}
                      {%- assign rk_last = image_url | split: 'backblazeb2.com/file/recipekit-bucket/' -%}
                      {%- assign card_image = 'https://images.getrecipekit.com/' | append: rk_last[1] | append: '?aspect_ratio=1:1&quality=90&' -%}
                    {%- elsif image_url contains 'cdn.shopify.com' -%}
                      {%- assign card_image = image_url | append: '&width=1000&height=1000' -%}
                    {%- else -%}
                      {%- assign card_image = image_url -%}
                    {%- endif -%}
                    <img class="recipekit-card-image" src="{{ card_image }}" alt="{{ article.title | escape }}" loading="lazy">
                  {%- elsif article.image -%}
                    <img class="recipekit-card-image" src="{{ article.image | img_url: '1000x1000', scale: 2 }}" alt="{{ article.title | escape }}" loading="lazy">
                  {%- endif -%}
                  {%- if rk_mf and rk_mf.prep_time != blank -%}
                    <span class="recipekit-prep-time">{{ rk_mf.prep_time }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            <div class="recipekit-card-meta">
              {%- if rk_mf and rk_mf.recipe_category != blank -%}
                {%- assign badge_color = '' -%}
                {%- assign tag_pairs = tag_color_map | split: ',' -%}
                {%- for pair in tag_pairs -%}
                  {%- assign tag_item = pair | split: ':' | first -%}
                  {%- assign color    = pair | split: ':' | last  -%}
                  {%- if rk_mf.recipe_category == tag_item -%}
                    {%- assign badge_color = color -%}
                  {%- endif -%}
                {%- endfor -%}
                <span class="recipekit-category-badge"{% if badge_color != '' %} style="background: {{ badge_color }}"{% endif %}>{{ rk_mf.recipe_category }}</span>
              {%- endif -%}
              <a href="{{ article.url }}" class="recipekit-card-title-link">
                <div class="recipekit-card-title">{{ article.title }}</div>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "All Recipes Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Category Tag",
      "settings": [
        { "type": "text",  "id": "tag",          "label": "Article tag" },
        { "type": "color", "id": "banner_color", "label": "Badge colour" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "All Recipes Grid" }
  ]
}
{% endschema %}